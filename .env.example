# Copy this file to .env next to docker-compose.yml and fill in the secrets:
#   cp .env.example .env && chmod 600 .env
#
# Values are injected into the container as environment variables. They are never
# committed and never baked into the image. ASP.NET Core configuration uses "__"
# as the nesting separator, e.g. HomeAssistant__Token maps to HomeAssistant:Token.

# --- Home Assistant (outbound calls made by HomeDaemon) ----------------------
HomeAssistant__BaseUrl=http://homeassistant.local:8123/
HomeAssistant__Token=change-me-long-lived-access-token
HomeAssistant__TimeoutSeconds=30

# --- Machine credential used by Home Assistant to call HomeDaemon ------------
# Generate a long random value. Home Assistant sends it in the X-Api-Key header.
ApiKey__Value=change-me-long-random-value

# --- Scheduling, sync and backup (optional; defaults live in appsettings.json)
Recalculation__NightlyRunTime=02:00
Backup__DailyRunTime=03:00
Backup__RetentionCount=14
TodoSync__BatchSize=50
TodoSync__MaxAttempts=5
TodoSync__SyncIntervalSeconds=30

# --- Reverse proxy (optional) ------------------------------------------------
# Enable this when a TLS-terminating proxy (for example Tailscale Serve) sits in front
# of the container, so the app restores the original https scheme. Trust only the proxy:
# list its address in KnownProxies or its network in KnownNetworks. If the request's
# source is not covered, the middleware logs "Unknown proxy: <address>" and ignores the
# forwarded headers. Matching the container's Docker network is a common choice.
# ForwardedHeaders__Enabled=true
# ForwardedHeaders__KnownNetworks__0=172.18.0.0/16

# --- Host settings -----------------------------------------------------------
# Timezone used by the container and by the scheduler's local time windows.
TZ=Europe/Rome
# Watchtower poll interval in seconds (3600 = one hour).
WATCHTOWER_POLL_INTERVAL=3600
