<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      CA1515 (make application types internal) conflicts here with CA1812 (avoid uninstantiated
      internal classes): the DI container, the minimal-API model binder and the Identity
      infrastructure create types via reflection, which CA1812 cannot see. Keeping the types
      public preserves CA1812's dead-code detection across the whole application project.
    -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HomeDaemon.Application\HomeDaemon.Application.csproj" />
    <ProjectReference Include="..\HomeDaemon.DataAccess\HomeDaemon.DataAccess.csproj" />
  </ItemGroup>

</Project>
