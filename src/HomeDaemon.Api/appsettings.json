{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HomeDaemon": "Data Source=data/home-daemon.db"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "ApiKey": {
    "Value": ""
  },
  "Recalculation": {
    "NightlyRunTime": "02:00"
  },
  "Backup": {
    "Enabled": true,
    "DailyRunTime": "03:00",
    "Directory": "",
    "RetentionCount": 14
  },
  "TodoSync": {
    "BatchSize": 50,
    "MaxAttempts": 5,
    "SyncIntervalSeconds": 30
  },
  "Scheduling": {
    "DueDateDistanceWeight": 10.0,
    "LatePenaltyWeight": 4.0,
    "RemainingCapacityWeight": 3.0,
    "LoadBalanceWeight": 1.0,
    "SameRoomBonus": 4.0
  }
}
