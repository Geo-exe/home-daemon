<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
        <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <!-- Analyzer Performance (src) -->
        <PackageVersion Include="Meziantou.Analyzer" Version="3.0.303" />
        <PackageVersion Include="ZeroAlloc.Analyzers" Version="1.4.0" />
        <PackageVersion Include="ErrorProne.NET.Structs" Version="0.1.2" />
        <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />

        <!-- Microsoft.Testing.Platform & Test Frameworks (tests) -->
        <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.5.1" />
        <PackageVersion Include="xunit.v3" Version="4.0.2" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />

        <!-- Test Libraries -->
        <PackageVersion Include="NSubstitute" Version="6.2.0" />
        <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
        <PackageVersion Include="Bogus" Version="35.6.5" />
        <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />

        <!-- Integration Testing -->
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    </ItemGroup>
</Project>
